# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- Better Auth ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------- Database (Neon via Vercel Store; run `vercel env pull .env.local`) ----------
DATABASE_URL=            # pooled, used at runtime
DATABASE_URL_UNPOOLED=   # direct, used for migrations

# ---------- Email / OTP (Brevo) ----------
MAIL_DRIVER=console      # console | brevo  (use console until sender is verified)
BREVO_API_KEY=
MAIL_FROM_EMAIL=         # must be a verified Brevo sender
MAIL_FROM_NAME=C.R.I.B.S.

# ---------- AI ----------
AI_PROVIDER=anthropic    # anthropic | openai
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_RATE_LIMIT_PER_HOUR=30

# ---------- Feature flags / config ----------
TAG_NAME=Cribseer
RESEARCH_MODE=false
MODERATOR_EMAILS=        # comma-separated
RESEARCHER_EMAILS=       # comma-separated (research CSV export)
