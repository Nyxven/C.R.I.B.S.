# Copy to .env.local for local dev. NEVER commit real values: only this file is tracked.
# Production values live in Vercel (Project > Settings > Environment Variables). See VERCEL_ENV.md.

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
TAG_NAME=CRIBS
RESEARCH_MODE=false

# ---------- Auth secrets (SECRET) ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   (min 32 chars, all different)
AUTH_SECRET=
PASSWORD_PEPPER=
# Rotation (optional): move the old value here, set a fresh one above, deploy, remove after ~30 days.
AUTH_SECRET_PREVIOUS=
PASSWORD_PEPPER_PREVIOUS=

# ---------- Database (Neon via Vercel Storage; `vercel env pull .env.local`) ----------
DATABASE_URL=            # pooled, runtime
DATABASE_URL_UNPOOLED=   # direct, migrations

# ---------- Email / OTP (Brevo) ----------
MAIL_DRIVER=console      # console (dev) | brevo (production)
BREVO_API_KEY=           # SECRET
MAIL_FROM_EMAIL=         # a sender verified in Brevo
MAIL_FROM_NAME=C.R.I.B.S.

# ---------- AI (not used yet, phase P5) ----------
# --- AI guide (free-model friendly). Without a key the Ask tab says "not available" and search still works.
AI_PROVIDER=openai-compatible   # openai-compatible (Gemini, OpenRouter, Groq...) | anthropic
AI_BASE_URL=                    # e.g. the provider's OpenAI-compatible address (https only)
AI_MODEL=                       # a model id from your provider (a free one is fine)
AI_API_KEY=                     # SECRET (anthropic: set ANTHROPIC_API_KEY instead)
# Limits (small on purpose; match your provider's free quota, raise when you upgrade)
AI_MAX_OUTPUT_TOKENS=450
AI_RATE_LIMIT_PER_HOUR=20       # per person
AI_USER_PER_DAY=60
AI_USER_TOKENS_PER_DAY=40000
AI_GLOBAL_PER_MIN=10            # whole app
AI_GLOBAL_PER_DAY=400
AI_GLOBAL_TOKENS_PER_DAY=400000

# --- Security
TRUST_PROXY=vercel              # vercel | cloudflare | none (see docs/CLOUDFLARE.md)
MAIL_DAILY_CAP=250
CRON_SECRET=                    # SECRET, 16+ characters; Vercel Cron sends it automatically
NEXT_PUBLIC_TURNSTILE_SITE_KEY= # optional (free bot check)
TURNSTILE_SECRET_KEY=           # SECRET, optional
