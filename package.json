{
  "name": "cribs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "check-env": "tsx scripts/check-env.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "check-secrets": "node scripts/check-secrets.mjs --all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
